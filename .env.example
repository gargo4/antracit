# ═══════════════════════════════════════════════════════════════
#  ANTRACIT — настройки. Скопируй этот файл в  .env.local  и впиши значения.
#      cp .env.example .env.local
#  На хостинге (Vercel / Railway / свой сервер) те же переменные
#  добавляются в разделе Environment Variables.
#  Файл .env.local в git НЕ попадает (см. .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── 1. API-ключи (сюда вписываешь три ключа) ────────────────────
# Ключ 1 — основной, Ключ 2 — второй, Ключ 3 — «Запасной».
# Ключи живут только на сервере и в браузер никогда не отдаются.
# Пустое значение = слот не используется.
AI_KEY_1=
AI_KEY_2=
AI_KEY_3=

# ── 2. Провайдер и модели ───────────────────────────────────────
# Любой OpenAI-совместимый API (путь /chat/completions, поддержка stream).
# По умолчанию — Google Gemini (ключи вида AQ.… / AIza…):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Другие провайдеры:
#   OpenAI      https://api.openai.com/v1            (gpt-4o-mini)
#   OpenRouter  https://openrouter.ai/api/v1         (openai/gpt-4o-mini, google/gemini-2.0-flash-001)
#   Groq        https://api.groq.com/openai/v1       (vision: meta-llama/llama-4-scout-17b-16e-instruct)

# ЦЕПОЧКА МОДЕЛЕЙ через запятую, от лучшей к запасным. Если модель недоступна
# (403, 404, лимит, сбой) — сервер сам, без ошибки для пользователя, берёт
# следующую модель и/или следующий ключ.
AI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite
# Модели для режима «Анализ по картинке» (vision). Пусто = те же, что выше.
AI_VISION_MODELS=

# Необязательно: максимум токенов в ответе и «температура»
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.4

# Необязательно (нужно для OpenRouter-статистики)
AI_HTTP_REFERER=
AI_APP_TITLE=ANTRACIT

# ── 3. Бесплатный лимит и защита от «слива» ────────────────────
# Сколько бесплатных запросов в сутки на одного пользователя.
# 0 = без ограничений (удобно для личного тестирования).
FREE_REQUESTS_PER_DAY=15

# Максимум символов в одном сообщении
MAX_TEXT_CHARS=8000
# Максимальный размер картинки после сжатия, байт (1500000 ≈ 1,5 МБ)
MAX_IMAGE_BYTES=1500000
# Сколько последних сообщений диалога уходит в нейросеть как контекст
MAX_HISTORY_MESSAGES=10

# Надёжный учёт лимита на Vercel/serverless (необязательно, но рекомендуется).
# Vercel → Storage → Upstash Redis — переменные подставятся сами.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 4. Необязательно: PIN для переключения ключей ──────────────
# Если задан — переключать «Ключ 1/2/Запасной» в настройках сможет только
# тот, кто ввёл этот PIN. Остальные пользователи работают в авто-режиме.
ADMIN_PIN=
